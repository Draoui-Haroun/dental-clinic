{
  "name": "dental-clinic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run copy-static",
    "copy-static": "node scripts/copy-static.mjs",
    "start": "next start",
    "lint": "eslint",
    "electron": "electron electron-dist/main.js",
    "desktop": "electron electron-dist/main.js"
  },
  "build": {
    "appId": "com.dentalclinic.app",
    "productName": "Cabinet Dentaire",
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      ".next/standalone/**/*",
      "db/schema.sql"
    ],
    "files": [
      ".next/standalone/**/*",
      ".next/static/**/*",
      "public/**/*",
      "electron/**/*",
      "electron-dist/**/*",
      "package.json",
      "db/schema.sql"
    ],
    "extraMetadata": {
      "main": "electron-dist/main.js"
    },
    "win": {
      "target": "nsis",
      "icon": "public/dental_app_icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0"
  }
}